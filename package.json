{
  "name": "docs-and-api-test-playwrithe",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test:debug": "LOG_LEVEL=debug npx playwright test",
    "test:info": "LOG_LEVEL=info npx playwright test",
    "test:warn": "LOG_LEVEL=warn npx playwright test",
    "test:error": "LOG_LEVEL=error npx playwright test",
    "test:fatal": "LOG_LEVEL=fatal npx playwright test",
    "test:trace": "LOG_LEVEL=trace npx playwright test",
    "test:off": "LOG_LEVEL=off npx playwright test",
    "test": "npx playwright test",
    "test:ci": "npx playwright test --retries=2 --workers=1",           
    "test:pr": "npx playwright test --grep @smoke --retries=1",         
    "test:smoke": "npx playwright test --grep @smoke",                 
    "test:regression": "npx playwright test --grep @regression",        
    "postinstall": "npx playwright install chromium",                   
    "lint": "eslint . --ext .js,.mjs,.cjs,.ts,.mts,.cts --max-warnings=0",
    "lint:fix": "eslint . --ext .js,.mjs,.cjs,.ts,.mts,.cts --fix"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.52.0",
    "@types/node": "^22.19.17",
    "dotenv": "^17.2.2",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "jiti": "^2.6.1",
    "typescript-eslint": "^8.48.0"
  },
  "dependencies": {
    "log4js": "^6.9.1"
  }
}
